{
  "info": {
    "_postman_id": "a96f9a36-d87b-4627-8bb0-6ab26862b07a",
    "name": "Micro-Service-Mern API",
    "description": "Requests for the API gateway, auth service, and todo service. Start the stack with `docker compose up --build`. Run the requests in order for the full register/login/todo CRUD flow. Register generates a fresh email each time; login saves the returned JWT as the collection variable `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:4001",
      "type": "string"
    },
    {
      "key": "todoUrl",
      "value": "http://localhost:4002",
      "type": "string"
    },
    {
      "key": "email",
      "value": "postman-user@example.com",
      "type": "string"
    },
    {
      "key": "password",
      "value": "ChangeMe123!",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "todoId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Gateway is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authUrl}}/health",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Auth service is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Todo service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{todoUrl}}/health",
              "host": [
                "{{todoUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todo service is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'postman-' + Date.now() + '@example.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test User\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a fresh test user and updates the email collection variable before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User is registered', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().userId).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds and returns a JWT', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('userId', String(data.user.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Validate token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "validate"
              ]
            },
            "description": "Gateway-protected token validation. Login first so the token variable is populated."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token is valid', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().valid).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Todos",
      "item": [
        {
          "name": "List todos",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todos are returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Create todo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todo is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.data.id).to.exist;",
                  "  pm.collectionVariables.set('todoId', String(data.data.id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test todo from Postman\",\n  \"description\": \"Created by the API collection\",\n  \"status\": \"Pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get todo by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todo is returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('todoId')));",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Update todo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman test todo\",\n  \"description\": \"Updated by the API collection\",\n  \"status\": \"Completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todo is updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Delete todo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/todos/{{todoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos",
                "{{todoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todo is deleted', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List todos without token (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/todos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "todos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Protected endpoint rejects missing token', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
